# Optional fallback credentials for local development.
# When present, the app uses these as the default auth before the user
# overrides via the in-app Settings modal (which writes to localStorage).
#
# How to get them:
#   1. Open https://www.rappi.com.co and sign in.
#   2. Open DevTools (F12) > Network tab.
#   3. Refresh the page and filter by "filters/".
#   4. Click any request and copy the values from Request Headers.
#
# This file is gitignored. Never commit real credentials.

VITE_RAPPI_AUTH=Bearer YOUR_TOKEN_HERE
VITE_RAPPI_DEVICEID=your-deviceid-uuid
VITE_RAPPI_APP_VERSION=1.161.2
